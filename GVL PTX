local BgImage = {
    enabled = false,
    url = "",
    resolvedUrl = "",
    transparency = 0.3,
    imageTransparency = 0,
    label = nil,
    frame = nil,
    frameOriginalBg = nil,
    scaleType = "Crop",
    appliedByScript = false,
    downloading = false,
}

local function isExternalUrl(url)
    if not url or url == "" then return false end
    if url:match("^rbxasset") or url:match("^rbxassetid") then return false end
    return url:match("^https?://") ~= nil
end

local function getExtensionFromUrl(url)
    local path = url:match("^[^?]+") or url
    local ext = path:match("%.([%w]+)$")
    if ext then return ext:lower() end
    return "png"
end

local function ensureFolderExists(folder)
    if not isfolder or not makefolder then return false end
    pcall(function()
        if not isfolder(folder) then makefolder(folder) end
    end)
    return true
end

local function urlToAsset(url)
    if not url or url == "" then return "" end
    if url:match("^rbxasset") then return url end
    if not isExternalUrl(url) then return url end

    local hasFileAPI = getcustomasset and writefile and isfile and (isfolder and makefolder)
    if not hasFileAPI then return url end

    local folder = "PTX_BgImages"
    if not ensureFolderExists(folder) then return url end

    local hash = 0
    for i = 1, #url do
        hash = (hash * 31 + string.byte(url, i)) % 2147483647
    end
    local ext = getExtensionFromUrl(url)
    local filename = folder .. "/bg_" .. tostring(hash) .. "." .. ext

    if isfile(filename) then
        local ok, asset = pcall(getcustomasset, filename)
        if ok and asset then return asset end
    end

    local ok, data = pcall(function()
        return game:HttpGet(url, true)
    end)

    if not ok or not data or #data == 0 then return url end

    local firstBytes = data:sub(1, 15):lower()
    if firstBytes:find("<!doctype") or firstBytes:find("<html") then return url end

    local writeOk = pcall(function() writefile(filename, data) end)
    if not writeOk then return url end

    local assetOk, asset = pcall(getcustomasset, filename)
    if assetOk and asset then return asset end

    return url
end

local function findLibraryMainFrame()
    local roots = {}
    if gethui then table.insert(roots, gethui()) end
    table.insert(roots, CoreGui)
    if LocalPlayer:FindFirstChild("PlayerGui") then table.insert(roots, LocalPlayer.PlayerGui) end

    local bestFrame = nil
    local bestScore = 0

    for _, root in ipairs(roots) do
        for _, gui in ipairs(root:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, d in ipairs(gui:GetDescendants()) do
                    if d:IsA("Frame") and d.Visible and not d:FindFirstChild("PTX_BackgroundImage") then
                        local w = d.AbsoluteSize.X
                        local h = d.AbsoluteSize.Y
                        if w >= 350 and h >= 250 then
                            local score = w * h
                            if score > bestScore and d.Name ~= "PTX_BackgroundImage" then
                                bestScore = score
                                bestFrame = d
                            end
                        end
                    end
                end
            end
        end
    end
    return bestFrame
end

local function removeBackground()
    if BgImage.label then
        pcall(function() BgImage.label:Destroy() end)
        BgImage.label = nil
    end
    if BgImage.frame and BgImage.frameOriginalBg then
        pcall(function()
            BgImage.frame.BackgroundTransparency = BgImage.frameOriginalBg.transparency
            BgImage.frame.BackgroundColor3 = BgImage.frameOriginalBg.color
        end)
    end
    BgImage.appliedByScript = false
end

local function applyBackground()
    removeBackground()
    if not BgImage.enabled or BgImage.url == "" then return end

    if not BgImage.frame or not BgImage.frame.Parent then
        BgImage.frame = findLibraryMainFrame()
    end

    if not BgImage.frame then
        task.spawn(function()
            for _ = 1, 15 do
                task.wait(0.3)
                BgImage.frame = findLibraryMainFrame()
                if BgImage.frame and BgImage.enabled then
                    applyBackground()
                    return
                end
            end
        end)
        return
    end

    if not BgImage.frameOriginalBg then
        BgImage.frameOriginalBg = {
            transparency = BgImage.frame.BackgroundTransparency,
            color = BgImage.frame.BackgroundColor3,
        }
    end

    BgImage.frame.BackgroundTransparency = BgImage.transparency
    BgImage.appliedByScript = true

    local clip = Instance.new("Frame")
    clip.Name = "PTX_BackgroundImage"
    clip.Size = UDim2.new(1, 0, 1, 0)
    clip.Position = UDim2.new(0, 0, 0, 0)
    clip.BackgroundTransparency = 1
    clip.BorderSizePixel = 0
    clip.ClipsDescendants = true
    clip.ZIndex = 0
    clip.Parent = BgImage.frame

    local img = Instance.new("ImageLabel")
    img.Name = "BgImg"
    img.Size = UDim2.new(1, 0, 1, 0)
    img.Position = UDim2.new(0, 0, 0, 0)
    img.BackgroundTransparency = 1
    img.BorderSizePixel = 0
    img.ImageTransparency = BgImage.imageTransparency
    img.ScaleType = (BgImage.scaleType == "Stretch")
        and Enum.ScaleType.Stretch
        or (BgImage.scaleType == "Fit" and Enum.ScaleType.Fit or Enum.ScaleType.Crop)
    img.ZIndex = 0
    img.Parent = clip

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 20)
    corner.Parent = img

    BgImage.label = clip

    local url = BgImage.url
    if url:match("^rbxasset") then
        img.Image = url
        return
    end

    task.spawn(function()
        if BgImage.downloading then return end
        BgImage.downloading = true
        local asset = urlToAsset(url)
        BgImage.downloading = false
        if BgImage.label == clip and img.Parent then
            pcall(function() img.Image = asset end)
        end
    end)
end

