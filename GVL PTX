local AntiLagGroup = Tabs.Visuals:AddRightGroupbox("Anti Lag", "zap-off")

local AL = { autoClear = false, clearTask = nil, interval = 1, cleared = 0 }

local LAG_OBJECT_NAMES = {
    GrabBeam = true, GrabParts = true, PaintPlayerPart = true,
    ["GrabBeam_Effect"] = true, GrabLine = true,
}

local function clearLagObjects()
    local count = 0
    for _, obj in ipairs(Workspace:GetChildren()) do
        if LAG_OBJECT_NAMES[obj.Name] then
            pcall(function() obj:Destroy() end)
            count = count + 1
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "PaintPlayerPart" then
            pcall(function() obj:Destroy() end)
            count = count + 1
        end
    end
    return count
end

