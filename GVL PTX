    local function setOceanCollide(state)
        pcall(function()
            local oceanModel = Workspace:FindFirstChild("Map")
            if oceanModel then
                oceanModel = oceanModel:FindFirstChild("AlwaysHereTweenedObjects")
                if oceanModel then
                    oceanModel = oceanModel:FindFirstChild("Ocean")
                    if oceanModel then
