do
    local SKIP_KEYWORDS = {"divider", "separator", "line", "stroke", "shadow", "glow", "outline", "background"}
    local function shouldSkip(obj)
        local n = string.lower(obj.Name)
        for _, kw in ipairs(SKIP_KEYWORDS) do
            if string.find(n, kw, 1, true) then return true end
        end
        return false
    end

    local function styleGuiObject(obj)
        if shouldSkip(obj) then return end
        local abs = obj.AbsoluteSize
        if abs.Y <= 3 or abs.X <= 3 then return end
        if obj:IsA("Frame") then
            if obj.BackgroundTransparency < 1 then
                obj.BackgroundTransparency = math.max(obj.BackgroundTransparency, 0.35)
            end
            if not obj:FindFirstChildOfClass("UICorner") and (obj.Size.Y.Offset >= 60 or obj.Size.Y.Scale >= 0.3) then
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 10)
                corner.Parent = obj
            end
        elseif obj:IsA("TextButton") then
            obj.BackgroundTransparency = math.max(obj.BackgroundTransparency, 0.55)
            if not obj:FindFirstChildOfClass("UICorner") then
                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(0, 6)
                c.Parent = obj
            end
        elseif obj:IsA("ScrollingFrame") then
            obj.BackgroundTransparency = math.max(obj.BackgroundTransparency, 0.55)
            obj.BorderSizePixel = 0
        elseif obj:IsA("TextBox") then
            obj.BackgroundTransparency = math.max(obj.BackgroundTransparency, 0.55)
        elseif obj:IsA("TextLabel") and obj.BackgroundTransparency < 1 then
            obj.BackgroundTransparency = math.max(obj.BackgroundTransparency, 0.5)
        end
    end

    local function findLibraryGui()
        local roots = {}
        if gethui then table.insert(roots, gethui()) end
        table.insert(roots, CoreGui)
        if LocalPlayer:FindFirstChild("PlayerGui") then table.insert(roots, LocalPlayer.PlayerGui) end
        for _, root in ipairs(roots) do
            for _, gui in ipairs(root:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    local name = gui.Name:lower()
                    if name:find("obsidian") or name:find("library") or name:find("ptx") or name:find("menu") then
                        return gui
                    end
                end
            end
        end
        for _, root in ipairs(roots) do
            for _, gui in ipairs(root:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    for _, d in ipairs(gui:GetDescendants()) do
                        if d:IsA("Frame") and d.Size.X.Offset >= 400 then return gui end
                    end
                end
            end
        end
        return nil
    end

    local function solidDropdown(obj)
        if not (obj:IsA("TextButton") or obj:IsA("Frame")) then return end
        local n = string.lower(obj.Name)
        local isDropdown = n:find("dropdown") or n:find("option") or n:find("value") or n:find("selected") or n:find("list") or n:find("picker")
        if isDropdown then
            if obj:IsA("TextButton") then
                obj.BackgroundTransparency = 0
                obj.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
            elseif obj:IsA("Frame") then
                obj.BackgroundTransparency = 0
                obj.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
            end
            local s = obj:FindFirstChildOfClass("UIStroke")
            if s then s:Destroy() end
            local c = obj:FindFirstChildOfClass("UICorner")
            if not c then
                c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(0, 6)
                c.Parent = obj
            end
        end
    end

    task.spawn(function()
        for i = 1, 8 do
            task.wait(i == 1 and 0.15 or 0.5)
            local gui = findLibraryGui()
            if gui then
                for _, v in ipairs(gui:GetDescendants()) do
                    pcall(styleGuiObject, v)
                    pcall(solidDropdown, v)
                end
            end
        end
        local gui = findLibraryGui()
        if gui then
            gui.DescendantAdded:Connect(function(obj)
                task.wait(0.05)
                if not shouldSkip(obj) then pcall(styleGuiObject, obj) end
                pcall(solidDropdown, obj)
            end)
        end
    end)
end

