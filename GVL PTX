                        if oceanModel then
                            oceanModel = oceanModel:FindFirstChild("ObjectModel")
                            if oceanModel then
                                for _, part in pairs(oceanModel:GetChildren()) do
                                    if part:IsA("BasePart") and part.Name == "Ocean" then part.CanCollide = state end
                                end
                            end
                        end
                    end
                end
            end
            for _, part in pairs(Workspace:GetDescendants()) do
                if part:IsA("BasePart") and (part.Material == Enum.Material.Water or string.find(string.lower(part.Name), "water")) then
                    part.CanCollide = state
                end
            end
        end)
    end

