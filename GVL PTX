RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    if not Camera then return end

    local col
    if CESP.RGBMode then
        local hue = tick() % 5 / 5
        col = Color3.fromHSV(hue, 1, 1)
        lastThemeColor = col
    else
        col = CESP.ThemeColor
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end

        if not espCache[p] then
            addPlayerESP(p)
        end

        local esp = espCache[p]
        if not esp then continue end

        local ch = p.Character
        local hide = true

        if CESP.EnableESP and ch then
            local hrp  = ch:FindFirstChild("HumanoidRootPart")
            local head = ch:FindFirstChild("Head")
            local hum  = ch:FindFirstChildOfClass("Humanoid")

            if hrp and head and hum and hum.Health > 0 then
                local isTeam = isAlly(p)
                local allowed = not (CESP.EnemyOnly and isTeam)

                if allowed then
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    if dist <= CESP.MaxDistance then
                        local cf, size = ch:GetBoundingBox()
                        local topWorld = (cf + Vector3.new(0, size.Y / 2, 0)).Position
                        local bottomWorld = (cf - Vector3.new(0, size.Y / 2, 0)).Position

                        local topScreen, topVis = Camera:WorldToViewportPoint(topWorld)
                        local bottomScreen, bottomVis = Camera:WorldToViewportPoint(bottomWorld)
                        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                        if topVis or bottomVis or onScreen then
                            hide = false

                            local h = math.abs(topScreen.Y - bottomScreen.Y)
                            local w = h / 2
                            local x = topScreen.X - w / 2
                            local y = topScreen.Y
                            local pcol = isTeam and Color3.fromRGB(0, 170, 255) or col

                            if CESP.BoxESP and esp.Box then
                                esp.Box.Visible = true
                                esp.Box.Size = Vector2.new(w, h)
                                esp.Box.Position = Vector2.new(x, y)
                                esp.Box.Color = pcol
                            elseif esp.Box then
                                esp.Box.Visible = false
                            end

                            if CESP.NameESP and esp.Name then
                                esp.Name.Visible = true
                                esp.Name.Text = p.Name
                                esp.Name.Position = Vector2.new(screenPos.X, y - 18)
                                esp.Name.Color = pcol
                            elseif esp.Name then
                                esp.Name.Visible = false
                            end

                            if CESP.DistanceESP and esp.Distance then
                                esp.Distance.Visible = true
                                esp.Distance.Text = math.floor(dist) .. " studs"
                                esp.Distance.Position = Vector2.new(screenPos.X, y + h + 2)
                            elseif esp.Distance then
                                esp.Distance.Visible = false
                            end

                            if CESP.HealthBar and esp.HealthBarBg and esp.HealthBar then
                                local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                                local barH = h * healthPct

                                esp.HealthBarBg.Visible = true
                                esp.HealthBarBg.Size = Vector2.new(3, h + 2)
                                esp.HealthBarBg.Position = Vector2.new(x - 6, y - 1)

                                esp.HealthBar.Visible = true
                                esp.HealthBar.Size = Vector2.new(1, barH)
                                esp.HealthBar.Position = Vector2.new(x - 5, y + (h - barH))
                                esp.HealthBar.Color = Color3.fromRGB(255 - (healthPct * 255), healthPct * 255, 0)
                            else
                                if esp.HealthBarBg then esp.HealthBarBg.Visible = false end
                                if esp.HealthBar then esp.HealthBar.Visible = false end
                            end

                            if CESP.HeadDot and esp.HeadDot then
                                local headPos, headVis = Camera:WorldToViewportPoint(head.Position)
                                if headVis then
                                    esp.HeadDot.Visible = true
                                    esp.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
                                    esp.HeadDot.Color = pcol
                                else
                                    esp.HeadDot.Visible = false
                                end
                            elseif esp.HeadDot then
                                esp.HeadDot.Visible = false
                            end

                            if CESP.Tracers and esp.Tracer then
                                esp.Tracer.Visible = true
                                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                                esp.Tracer.To = Vector2.new(screenPos.X, y + h)
                                esp.Tracer.Color = pcol
                            elseif esp.Tracer then
                                esp.Tracer.Visible = false
                            end

                            if CESP.SkeletonESP then
                                local joints = {
                                    {head, ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")},
                                    {ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso"), ch:FindFirstChild("LeftUpperArm")},
                                    {ch:FindFirstChild("LeftUpperArm"), ch:FindFirstChild("LeftLowerArm")},
                                    {ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso"), ch:FindFirstChild("RightUpperArm")},
                                    {ch:FindFirstChild("RightUpperArm"), ch:FindFirstChild("RightLowerArm")},
                                    {ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso"), ch:FindFirstChild("LowerTorso")},
                                    {ch:FindFirstChild("LowerTorso"), ch:FindFirstChild("LeftUpperLeg")},
                                    {ch:FindFirstChild("LeftUpperLeg"), ch:FindFirstChild("LeftLowerLeg")},
                                    {ch:FindFirstChild("LowerTorso"), ch:FindFirstChild("RightUpperLeg")},
                                    {ch:FindFirstChild("RightUpperLeg"), ch:FindFirstChild("RightLowerLeg")},
                                }
                                for idx, pair in ipairs(joints) do
                                    local line = esp.Skeleton[idx]
                                    if line and pair[1] and pair[2] then
                                        local p1, v1 = Camera:WorldToViewportPoint(pair[1].Position)
                                        local p2, v2 = Camera:WorldToViewportPoint(pair[2].Position)
                                        if v1 and v2 then
                                            line.Visible = true
                                            line.From = Vector2.new(p1.X, p1.Y)
                                            line.To = Vector2.new(p2.X, p2.Y)
                                            line.Color = pcol
                                        else
                                            line.Visible = false
                                        end
                                    elseif line then
                                        line.Visible = false
                                    end
                                end
                            else
                                for _, line in pairs(esp.Skeleton) do
                                    if line then line.Visible = false end
                                end
                            end

                            if CESP.Highlight then
                                if not esp.Highlight then
                                    local ok, hl = pcall(function()
                                        local h = Instance.new("Highlight")
                                        h.Name = "ColesiaESP_HL"
                                        h.Adornee = ch
                                        h.FillTransparency = 0.6
                                        h.OutlineTransparency = 1
                                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                        h.Parent = ch
                                        return h
                                    end)
                                    if ok then esp.Highlight = hl end
                                end
                                if esp.Highlight and esp.Highlight.Parent then
                                    esp.Highlight.FillColor = pcol
                                end
                            else
                                if esp.Highlight then
                                    esp.Highlight:Destroy()
                                    esp.Highlight = nil
                                end
                            end
                        end
                    end
                end
            end
        end

        if hide then
            if esp.Box then esp.Box.Visible = false end
            if esp.Name then esp.Name.Visible = false end
            if esp.Distance then esp.Distance.Visible = false end
            if esp.HealthBarBg then esp.HealthBarBg.Visible = false end
            if esp.HealthBar then esp.HealthBar.Visible = false end
            if esp.HeadDot then esp.HeadDot.Visible = false end
            if esp.Tracer then esp.Tracer.Visible = false end
            for _, line in pairs(esp.Skeleton) do
                if line then line.Visible = false end
            end
            if esp.Highlight and not CESP.EnableESP then
                esp.Highlight:Destroy()
                esp.Highlight = nil
            end
        end
    end

    if fovCircle then
        fovCircle.Position = UserInputService:GetMouseLocation()
        fovCircle.Radius = 0
        fovCircle.Color = col
        fovCircle.Visible = false
    end
end)

-- PCLD ESP (kept from original)
do
    local smoothPCLDs = {}
    local pcldPlayerCache = {}
    local espColor = Color3.fromRGB(255, 60, 60)
    local smoothTime = 0.18
    local cons = {}
    local rainbowPCLD = false

    VisL:AddLabel("ESP Color"):AddColorPicker("PCLDColor", {
        Default = espColor,
        Title = "PCLD ESP Color",
        Callback = function(v)
            espColor = v
            if not rainbowPCLD then
                for _, d in pairs(smoothPCLDs) do
                    if d.box then d.box.Color = v end
                    if d.outline then d.outline.Color3 = v end
                end
            end
        end,
    })

    VisL:AddCheckbox("RainbowPCLD", {
        Text = "PCLD Rainbow PCLD",
        Default = false,
        Callback = function(v)
            rainbowPCLD = v
            if v then
                task.spawn(function()
                    while rainbowPCLD do
                        local hue = tick() % 1
                        local color = Color3.fromHSV(hue, 1, 1)
                        for _, d in pairs(smoothPCLDs) do
                            if d.box then d.box.Color = color end
                            if d.outline then d.outline.Color3 = color end
                        end
                        task.wait(0.05)
                    end
                end)
            else
                espColor = Options.PCLDColor.Value or Color3.fromRGB(255, 60, 60)
                for _, d in pairs(smoothPCLDs) do
                    if d.box then d.box.Color = espColor end
                    if d.outline then d.outline.Color3 = espColor end
                end
            end
        end
    })

    local function createSmoothPCLD(original)
        if smoothPCLDs[original] then return end
        original.Transparency = 1
        local box = Instance.new("Part")
        box.Name = "PCLD_Box"
        box.Size = original.Size
        box.CFrame = original.CFrame
        box.Anchored = true
        box.CanCollide = false
        box.CanTouch = false
        box.CanQuery = false
        box.CastShadow = false
        box.Material = Enum.Material.Neon
        box.Color = espColor
        box.Transparency = 0.45
        box.Parent = Workspace
        local outline = Instance.new("SelectionBox")
        outline.Adornee = box
        outline.LineThickness = 0.02
        outline.Color3 = espColor
        outline.Transparency = 0.1
        outline.Parent = box
        local data = {box = box, outline = outline, original = original, lastUpdate = tick(), tween = nil}
        smoothPCLDs[original] = data
        task.spawn(function()
            local lastPos = original.Position
            while box.Parent and original.Parent do
                local pos = original.Position
                local cf = original.CFrame
                if (pos - lastPos).Magnitude > 0.02 then
                    lastPos = pos
                    if data.tween then data.tween:Cancel() end
                    data.tween = TweenService:Create(box, TweenInfo.new(smoothTime, Enum.EasingStyle.Linear), {CFrame = cf})
                    data.tween:Play()
                end
                task.wait(0.03)
            end
        end)
    end

    local function removeSmoothPCLD(original)
        local d = smoothPCLDs[original]
        if not d then return end
        if d.tween then d.tween:Cancel() end
        if d.box then d.box:Destroy() end
        smoothPCLDs[original] = nil
        pcldPlayerCache[original] = nil
    end

    local function clearAllSmoothPCLDs()
        for _, d in pairs(smoothPCLDs) do
            if d.tween then d.tween:Cancel() end
            if d.box then d.box:Destroy() end
        end
        smoothPCLDs = {}
        pcldPlayerCache = {}
    end

    VisL:AddCheckbox("ViewPCLD", {
        Text = "PCLD ESP",
        Default = false,
        Callback = function(v)
            if v then
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj.Name == "PlayerCharacterLocationDetector" then createSmoothPCLD(obj) end
                end
                cons.viewpcld = Workspace.ChildAdded:Connect(function(child)
                    if child.Name == "PlayerCharacterLocationDetector" then
                        task.wait(0.1)
                        createSmoothPCLD(child)
                    end
                end)
                cons.pcldRemoved = Workspace.ChildRemoved:Connect(function(child)
                    if child.Name == "PlayerCharacterLocationDetector" then removeSmoothPCLD(child) end
                end)
            else
                if cons.viewpcld then cons.viewpcld:Disconnect() end
                if cons.pcldRemoved then cons.pcldRemoved:Disconnect() end
                clearAllSmoothPCLDs()
            end
        end,
    })

    Options.PCLDColor:OnChanged(function()
        if not rainbowPCLD then
            espColor = Options.PCLDColor.Value
            for _, d in pairs(smoothPCLDs) do
                if d.box then d.box.Color = espColor end
                if d.outline then d.outline.Color3 = espColor end
            end
        end
    end)
end

