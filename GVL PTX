getgenv().ColesiaDrawings = getgenv().ColesiaDrawings or {}
local activeDrawings = getgenv().ColesiaDrawings

local function registerDrawing(obj)
    table.insert(activeDrawings, obj)
    return obj
end

local function createDrawing(dtype, properties)
    local ok, obj = pcall(function() return Drawing.new(dtype) end)
    if not ok or not obj then return nil end
    for i, v in pairs(properties) do
        pcall(function() obj[i] = v end)
    end
    return registerDrawing(obj)
end

local espCache = {}
local lastThemeColor = CESP.ThemeColor

local function isAlly(p)
    if not CESP.TeamCheck then return false end
    return LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team
end

local function addPlayerESP(p)
    if espCache[p] then return end
    local esp = {
        Box          = createDrawing("Square", {Thickness = 1.5, Filled = false, Transparency = 1}),
        Name         = createDrawing("Text", {Size = 13, Center = true, Outline = true, Color = Color3.new(1,1,1)}),
        Distance     = createDrawing("Text", {Size = 12, Center = true, Outline = true, Color = Color3.fromRGB(200,200,200)}),
