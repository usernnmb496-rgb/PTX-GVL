        HealthBar    = createDrawing("Square", {Thickness = 1, Filled = true, Color = Color3.fromRGB(0,255,0)}),
        HeadDot      = createDrawing("Circle", {Radius = 4, Filled = true, NumSides = 12}),
        Tracer       = createDrawing("Line", {Thickness = 1, Transparency = 0.8}),
        Highlight    = nil,
        Skeleton     = {},
    }
    for i = 1, 10 do
        esp.Skeleton[i] = createDrawing("Line", {Thickness = 1.5, Transparency = 0.8})
    end
    espCache[p] = esp
end

local function removePlayerESP(p)
    if not espCache[p] then return end
    for k, obj in pairs(espCache[p]) do
        if k == "Skeleton" then
            for _, line in pairs(obj) do
                pcall(function() line:Remove() end)
            end
        elseif k == "Highlight" then
            if obj then pcall(function() obj:Destroy() end) end
        else
            if obj then pcall(function() obj:Remove() end) end
        end
    end
    espCache[p] = nil
end

