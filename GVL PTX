    task.spawn(function()
        while task.wait(0.05) do
            if Toggles.EnableShaders and Toggles.EnableShaders.Value and currentShaderTheme then
                local theme = ShaderThemes[currentShaderTheme]
                if theme then
                    shaderLighting.Brightness = theme.Brightness
                    shaderLighting.Ambient = theme.Ambient
                    shaderLighting.OutdoorAmbient = theme.OutdoorAmbient
                    if theme.ClockTime then
                        shaderLighting.ClockTime = theme.ClockTime
                    end
                    if theme.ExposureCompensation then
                        shaderLighting.ExposureCompensation = theme.ExposureCompensation
                    end
                    if theme.GlobalShadows ~= nil then
                        shaderLighting.GlobalShadows = theme.GlobalShadows
                    else
                        shaderLighting.GlobalShadows = false
                    end
                    shaderLighting.FogEnd = theme.FogEnd
                    if theme.FogStart then shaderLighting.FogStart = theme.FogStart end

                    if theme.Use2022Materials then
                        pcall(function() game:GetService("MaterialService").Use2022Materials = true end)
                    else
                        pcall(function() game:GetService("MaterialService").Use2022Materials = false end)
                    end

                    if theme.ForceMaterials then
                        if not _G.MaterialsForced then
                            _G.MaterialsForced = true
                            applyRealMaterials()
                        end
                    else
                        if _G.MaterialsForced then
                            _G.MaterialsForced = false
                            restoreMaterials()
                        end
                    end

                    local atm = shaderLighting:FindFirstChildOfClass("Atmosphere")
                    if atm then
                        if Toggles.EnableCustomSky and Toggles.EnableCustomSky.Value then
                            atm.Enabled = true
                        else
                            atm.Enabled = false
                        end
                    end
                    for _, v in ipairs(shaderLighting:GetChildren()) do
                        if v ~= ccEffect and v ~= bloomEffect and v ~= sunRaysEffect then
                            if v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
                                v.Enabled = false
                            end
                        end
                    end
                    if ccEffect and theme.CC then
                        ccEffect.Enabled = true
                        if not ccEffect.Parent then ccEffect.Parent = shaderLighting end
                    end
                    if bloomEffect and theme.Bloom then
                        bloomEffect.Enabled = true
                        if not bloomEffect.Parent then bloomEffect.Parent = shaderLighting end
                    end
                    if sunRaysEffect and theme.SunRays then
                        sunRaysEffect.Enabled = true
                        if not sunRaysEffect.Parent then sunRaysEffect.Parent = shaderLighting end
                    end
                    if dofEffect and theme.DOF then
                        dofEffect.Enabled = true
                        if not dofEffect.Parent then dofEffect.Parent = shaderLighting end
                    end

                    if theme.EnvDiffuse then pcall(function() shaderLighting.EnvironmentDiffuseScale = theme.EnvDiffuse end) end
                    if theme.EnvSpecular then pcall(function() shaderLighting.EnvironmentSpecularScale = theme.EnvSpecular end) end
                end
            end
        end
    end)

    VisualShaders:AddDropdown("ShaderTheme", {
